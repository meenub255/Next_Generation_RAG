# ==============================================================================
# Enterprise Hybrid Graph RAG + Vector RAG Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Web Search API Keys
# ------------------------------------------------------------------------------
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Get your Tavily Search API key from: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# ------------------------------------------------------------------------------
# 2. Neo4j AuraDB (Free Cloud Graph Database)
# ------------------------------------------------------------------------------
# Get a 100% FREE Neo4j AuraDB instance (No credit card required):
# 1. Go to: https://neo4j.com/cloud/aura-free/
# 2. Sign up / Log in and click "New Instance" -> select "AuraDB Free"
# 3. Copy the generated Connection URI and Password
# 4. Fill in the values below:
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-auradb-generated-password
NEO4J_DATABASE=neo4j

# NOTE: If NEO4J_URI or NEO4J_PASSWORD is left blank, the system automatically 
# falls back to an embedded, high-performance Cypher Graph Simulator so you can 
# test Cypher queries and access control immediately with zero setup!

# ------------------------------------------------------------------------------
# 3. Qdrant Vector Store
# ------------------------------------------------------------------------------
# Leave blank for automatic high-performance In-Memory Qdrant mode (zero setup).
# Or provide your Qdrant Cloud cluster credentials from: https://cloud.qdrant.io/
QDRANT_URL=
QDRANT_API_KEY=
